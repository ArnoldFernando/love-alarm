{
  "expo": {
    "name": "Love Alarm",
    "slug": "love-alarm",
    "version": "1.0.0",
    "scheme": "lovealarm",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lovealarm.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your approximate location to detect when someone you like is nearby.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We use your approximate location to detect when someone you like is nearby, even when the app is in the background."
      }
    },
    "android": {
      "package": "com.lovealarm.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-location",
      "expo-notifications",
      "./plugins/withReactNativeNodeModulesDir.js"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "apiUrl": "EXPO_PUBLIC_API_URL",
      "router": {
        "origin": false,
        "root": "./src/app"
      },
      "eas": {
        "projectId": "49c1c1b4-4381-4533-9535-edf7a420b46c"
      }
    }
  }
}